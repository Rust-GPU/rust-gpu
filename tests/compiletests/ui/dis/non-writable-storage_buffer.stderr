               OpCapability Shader
               OpMemoryModel Logical Simple
               OpEntryPoint Fragment %1 "main"
               OpExecutionMode %1 OriginUpperLeft
          %2 = OpString "$DIR/non-writable-storage_buffer.rs"
               OpName %buf_imm "buf_imm"
               OpName %buf_mut "buf_mut"
               OpName %buf_interior_mut "buf_interior_mut"
               OpDecorate %_struct_6 Block
               OpMemberDecorate %_struct_6 0 Offset 0
               OpDecorate %buf_imm NonWritable
               OpDecorate %buf_imm Binding 0
               OpDecorate %buf_imm DescriptorSet 0
               OpDecorate %buf_mut Binding 1
               OpDecorate %buf_mut DescriptorSet 0
               OpDecorate %buf_interior_mut Binding 2
               OpDecorate %buf_interior_mut DescriptorSet 0
       %void = OpTypeVoid
          %8 = OpTypeFunction %void
        %u32 = OpTypeInt 32 0
%_ptr_StorageBuffer_u32 = OpTypePointer StorageBuffer %u32
  %_struct_6 = OpTypeStruct %u32
%_ptr_StorageBuffer__struct_6 = OpTypePointer StorageBuffer %_struct_6
    %buf_imm = OpVariable %_ptr_StorageBuffer__struct_6 StorageBuffer
      %u32_0 = OpConstant %u32 0
    %buf_mut = OpVariable %_ptr_StorageBuffer__struct_6 StorageBuffer
%buf_interior_mut = OpVariable %_ptr_StorageBuffer__struct_6 StorageBuffer
